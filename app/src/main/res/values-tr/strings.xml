    <!-- Dialogs/Permissions -->
    <string name="map_permission_title">Harita Seçici ve İnternet Erişimi</string>
    <string name="map_permission_message">Konum seçimi için bir harita göstermek üzere MetaJammer\'ın OpenStreetMap\'ten harita karoları yüklemek için internete bağlanması gerekir. \n\nReddederseniz, uygulama tüm metadata temizleme ve zehirleme özellikleri için kusursuz çalışmaya devam eder ancak harita üzerinde görsel olarak konum seçemezsiniz.</string>
    <string name="allow_open_map">İzin Ver ve Haritayı Aç</string>
    <string name="not_now">Şimdi Değil</string>

    <string name="notification_permission_title">Haberdar Olun</string>
    <string name="notification_permission_message">MetaJammer, arka planda işlenirken büyük dosya gruplarının ilerlemesi hakkında sizi bilgilendirmek için bildirimler gösterebilir. \n\nBu, özellikle MetaJammer işini bitirirken başka bir uygulamaya geçmek istediğinizde kullanışlıdır.</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome_title">MetaJammer\'a Hoş Geldiniz</string>
    <string name="onboarding_welcome_desc">Metadata gizliliği için kişisel araç takımınız. Dosyalarınızı dünyayla paylaşmadan önce temizleyin.</string>
    <string name="onboarding_poison_vs_remove_title">Zehirle vs Kaldır</string>
    <string name="onboarding_poison_vs_remove_desc"><b>Kaldır:</b> Tüm metadataları siler. Basit ve temiz.\n\n<b>Zehirle:</b> Hassas verileri sahte, gerçekçi değerlerle değiştirir. Bu, <i>makul reddedilebilirlik</i> sağlar ve otomatik takipçileri şaşırtır.</string>
    <string name="onboarding_permissions_title">Hazırlanıyoruz</string>
    <string name="onboarding_permissions_desc">MetaJammer\'ın en iyi şekilde çalışması için birkaç izne ihtiyacı var. Arka plan görevleri için bildirimleri ve harita seçici için interneti etkinleştirmeyi seçebilirsiniz.</string>
    <string name="onboarding_finish_title">Her Şey Hazır!</string>
    <string name="onboarding_finish_desc">Gizliliğinizi korumaya başlamaya hazırsınız. Başlamak için bazı dosyalar seçin veya diğer uygulamalardan paylaşın.</string>
    <string name="onboarding_get_started">Başlayın</string>
    <string name="onboarding_next">Sonraki</string>
    <string name="onboarding_skip">Atla</string>

