    <!-- HelpScreen -->
    <string name="help_title">Yardım ve Eğitimler</string>
    <string name="help_item_video_title">Video İşleme</string>
    <string name="help_item_video_body">Desteklenen formatlar: MP4, MOV, M4A, OGG.\n\nBu kapsayıcılar için tam remuxing desteklenir. Bu işlem, gizliliğinizi korumak için GPS, tarih ve cihaz atomlarını kaldırır.</string>
    <string name="help_item_image_title">Görüntü ve Vektör İşleme</string>
    <string name="help_item_image_body">Desteklenen formatlar: JPG, PNG, WebP, HEIF, SVG.\n\nMetaJammer, bitmap görüntülerden EXIF meta verilerini temizler ve SVG\'lerden XML/RDF meta verilerini temizler. \"Zehirleme\" modunda, hassas etiketleri gerçekçi rastgele verilerle değiştirir.</string>
    <string name="help_item_other_title">PDF ve Belge İşleme</string>
    <string name="help_item_other_body">Desteklenen formatlar: PDF.\n\nMetaJammer artık PDF belgelerini tam olarak destekliyor. Başlık, Yazar, Konu, Anahtar Kelimeler, Oluşturucu ve Üretici gibi meta verileri okuyabilir, silebilir ve \"zehirleyebilirsiniz\". Ayrıca, paylaşmadan önce belgelerinizin temiz olduğundan emin olmak için gizli filigranları ve açıklamaları da temizler.</string>
    <string name="help_report_issue_title">Sorun Bildir</string>
    <string name="help_report_issue_body">Bir hata mı buldunuz veya bir özellik isteğiniz mi var? Lütfen GitHub sayfamızda bildirin.</string>
    <string name="help_open_github">GitHub Sorunlarını Aç</string>
    <string name="help_app_version">Versiyon: %1$s</string>
